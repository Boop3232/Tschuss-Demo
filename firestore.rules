rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core authentication & authorization helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (userDocExists() && getUserData().role == 'admin')
      );
    }

    function isRetailer() {
      return isAuthenticated() && (
        request.auth.token.retailer == true ||
        (userDocExists() && (getUserData().role == 'retailer' || getUserData().role == 'admin'))
      );
    }

    // Users collection
    match /users/{userId} {
      // Authenticated users can read their own profile; admins can read any profile
      allow read: if isOwner(userId) || isAdmin();
      
      // User can create their profile on registration, but cannot set their role to 'admin' unless already admin
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'consumer' || 
        request.resource.data.role == 'retailer' || 
        isAdmin()
      );
      
      // User can update their own profile, but CANNOT modify their role (prevents client-side privilege escalation)
      // Admins can update any profile including roles
      allow update: if (
        isOwner(userId) && request.resource.data.role == resource.data.role
      ) || isAdmin();
      
      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }

    // Stores collection
    match /stores/{storeId} {
      // Store details are public so consumers can discover rescue deals
      allow read: if true;
      
      // Retailers & Admins can create and manage their store; initial demo seeding also permitted
      allow create: if isRetailer() || !exists(/databases/$(database)/documents/stores/$(storeId));
      allow update: if isRetailer() || isAdmin();
      allow delete: if isAdmin();
    }

    // Products collection (Rescue items)
    match /products/{productId} {
      // Rescue products are publicly viewable
      allow read: if true;
      
      // Retailers & Admins manage products; initial demo seeding permitted; inventory updates permitted
      allow create: if isRetailer() || !exists(/databases/$(database)/documents/products/$(productId));
      allow update: if true;
      allow delete: if isRetailer() || isAdmin();
    }

    // Reservations
    match /reservations/{reservationId} {
      // Reservations can be read, created, and updated by shoppers and retailers
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Saved Products (Wishlist / Favourites)
    match /savedProducts/{savedId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Notifications
    match /notifications/{notificationId} {
      // Users can only read and update their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Impact Events (Track CO2, money saved, items rescued)
    match /impactEvents/{eventId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Messages
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Business Inquiries (Public partner application form)
    match /businessInquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // System connection / status
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
